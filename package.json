{
  "name": "portal",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "meta": "bash scripts/meta.sh",
    "predev": "bun run meta",
    "dev": "vite",
    "build": "bun run build:mainnet",
    "build:mainnet": "NETWORK_NAME=mainnet bun run meta && vite build",
    "build:testnet": "NETWORK_NAME=testnet bun run meta && vite build",
    "build:base": "NETWORK_NAME=base bun run meta && vite build",
    "build:base-sepolia-testnet": "NETWORK_NAME=base-sepolia-testnet bun run meta && vite build",
    "build:qa": "NETWORK_NAME=legacy bun run meta && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "prettier": "prettier --write \"src/**/*.{ts,tsx,js,mdx}\""
  },
  "dependencies": {
    "@0xsequence/wallet-primitives": "^3.0.12",
    "@0xtrails/api": "^0.18.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@skalenetwork/skale-contracts-ethers-v6": "2.0.0-develop.6",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.5",
    "@vercel/analytics": "^2.0.1",
    "@wagmi/core": "^3.6.5",
    "boring-avatars": "^2.0.4",
    "clsx": "^2.1.1",
    "ethers": "^6.17.0",
    "lucide-react": "^1.34.0",
    "ox": "^0.14.34",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tslog": "^5.1.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.56.1",
    "wagmi": "^3.7.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "bun-types": "^1.4.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "typescript": "7.0.2",
    "vite": "^8.2.2"
  }
}
